<?xml version="1.0" encoding="utf-8"?>
<!--
  One notification box for the hinge strip: app icon + that app's notification count.
  Inflated once per notification by PeekController. Rounded top corners, flat bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:layout_marginStart="8dp"
    android:background="@drawable/peek_box_bg"
    android:gravity="center"
    android:minWidth="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <ImageView
        android:id="@+id/peek_box_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/peek_box_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>